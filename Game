        self.new_game_plus = False

        self.shop_inventory = []

        self.quest_pool = []

        self.story_flags = {
            "guardian": False,
            "sand_emperor": False,
            "frost_queen": False,
            "inferno_lord": False,
            "void_emperor": False,
        }

    # =========================================================================
    # START
    # =========================================================================

    def run(self):

        while self.running:

            clear()

            header(
                f"{GAME_NAME} — REALMS OF THE ENDLESS"
            )

            print(
                c(
                    """
        A world of infinite roads.
        Ancient powers sleep beneath forgotten kingdoms.
        Heroes rise.
        Heroes fall.

        One legend will reach the end.
                    """,
                    CYAN
                )
            )

            choice = choose(
                "Choose",
                [
                    "New Game",
                    "Load Game",
                    "How to Play",
                    "Quit",
                ]
            )

            if choice == 0:
                self.new_game()
                self.game_loop()

            elif choice == 1:
                if self.load():
                    self.game_loop()

            elif choice == 2:
                self.help_screen()

            else:
                self.running = False

