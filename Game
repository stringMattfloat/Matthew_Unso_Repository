# Save the original Game.game_loop so we can extend it without changing the
# massive class above.

_original_game_loop = Game.game_loop


def extended_game_loop(self):

    while self.running and self.player:

        # Unlock the final realm after the four major bosses.
        if Endgame.check(self):

            if not self.story_flags.get(
                "void_emperor",
                False
            ):

                clear()

                header("A NEW DESTINY")

                print(
                    c(
                        "The four ancient seals have shattered.",
                        MAGENTA
                    )
                )

                print(
                    "The path to the Void is open."
                )

                if choose(
                    "Enter the final realm?",
                    ["Yes", "Not yet"]
                ) == 0:

                    Endgame.final_battle(self)

                    if self.story_flags.get(
                        "void_emperor",
                        False
                    ):

                        return

        # Normal gameplay.
        clear()

        self.hud()

        choice = choose(
            "Action",
            [
                "Explore",
                "World Map",
                "Character",
                "Inventory",
                "Quests",
                "Skills & Magic",
                "Companions",
                "Town",
                "Crafting",
                "Rest",
                "Save",
                "Statistics",
                "Challenge a Boss",
                "Quit to Menu",
            ]
        )

        actions = [
            self.explore,
            self.show_map,
            self.character_screen,
            self.inventory_screen,
            self.quest_screen,
            self.skills_screen,
            self.companion_screen,
            self.town_menu,
            self.crafting,
            self.rest,
            self.save,
            self.statistics,
            self.challenge_boss,
            self.quit_to_menu,
        ]

        actions[choice]()


def challenge_boss(self):

    defeated = []

    if self.story_flags["guardian"]:
        defeated.append("Forest Guardian")

    if self.story_flags["sand_emperor"]:
        defeated.append("Sand Emperor")

    if self.story_flags["frost_queen"]:
        defeated.append("Frost Queen")

    if self.story_flags["inferno_lord"]:
        defeated.append("Inferno Lord")

    choices = []

    if not self.story_flags["guardian"]:
        choices.append("Forest Guardian")

    if not self.story_flags["sand_emperor"]:
        choices.append("Sand Emperor")

    if not self.story_flags["frost_queen"]:
        choices.append("Frost Queen")

    if not self.story_flags["inferno_lord"]:
        choices.append("Inferno Lord")

    if not choices:

        print(
            c(
                "All four guardians have been defeated.",
                GREEN
            )
        )

        pause()
        return

    choices.append("Cancel")

    selected = choose(
        "Choose a boss",
        choices
    )

    if selected == len(choices) - 1:
        return

    boss_name = choices[selected]

    index = {
        "Forest Guardian": 0,
        "Sand Emperor": 1,
        "Frost Queen": 2,
        "Inferno Lord": 3,
    }[boss_name]

    self.boss_fight(index)


Game.game_loop = extended_game_loop
Game.challenge_boss = challenge_boss


