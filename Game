            ("Legendary", 2.5),
            ("Mythic", 0.5),
        ])

        if chance(0.55):

            base = random.choice(
                POTIONS
            )

            return Item(
                name=base.name,
                kind="consumable",
                value=base.value,
                effect=base.effect,
                rarity=rarity,
                description=base.description,
            )

        material = random.choice(
