# =============================================================================
# BASIC UTILITIES
# =============================================================================

def c(text, color):
    return f"{color}{text}{RESET}"


def clear():
    os.system("cls" if os.name == "nt" else "clear")


def pause():
    input(c("\nPress Enter to continue...", DIM))


def slow(text, delay=0.01):
    for char in text:
        print(char, end="", flush=True)
        time.sleep(delay)
    print()


def line(char="=", width=WIDTH):
    print(char * width)


def header(title):
    print()
    line()
    print(c(title.center(WIDTH), BOLD + CYAN))
    line()


def ask(prompt):
    try:
        return input(prompt).strip()
    except (KeyboardInterrupt, EOFError):
        print()
        return "quit"


def choose(prompt, options):
    while True:
        print()
        for i, option in enumerate(options, 1):
            print(f"  {c(str(i), YELLOW)}. {option}")

        answer = ask(f"\n{prompt}: ")

        try:
            value = int(answer)
            if 1 <= value <= len(options):
                return value - 1
        except ValueError:
            pass

        print(c("Invalid choice.", RED))


def clamp(value, low, high):
    return max(low, min(high, value))


def chance(probability):
    return random.random() < probability


def roll(minimum, maximum):
    return random.randint(minimum, maximum)


def bar(current, maximum, width=25, color=GREEN):
    maximum = max(1, maximum)
    ratio = clamp(current / maximum, 0, 1)
    filled = int(ratio * width)
    empty = width - filled

    return (
        c("█" * filled, color)
        + c("░" * empty, DIM)
        + f" {current}/{maximum}"
    )


def weighted_choice(items):
    """
    items = [(value, weight), ...]
    """
    total = sum(weight for _, weight in items)
    value = random.uniform(0, total)

    for item, weight in items:
        value -= weight
        if value <= 0:
            return item

    return items[-1][0]


