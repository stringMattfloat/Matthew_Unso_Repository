    def death(self):

        p = self.player

        p.deaths += 1

        clear()

        header("YOU HAVE FALLEN")

        print(
            c(
                "Darkness surrounds you...",
                RED
            )
        )

        if p.gold > 20:

            lost = p.gold // 4

            p.gold -= lost

            print(
                f"You lose {lost} gold."
            )

        p.hp = max(
            1,
            p.max_hp // 2
        )

        p.mana = p.max_mana // 2

        print(
            c(
                "You awaken at the last safe place.",
                GREEN
            )
        )

        pause()

