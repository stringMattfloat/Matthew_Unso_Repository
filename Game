class Endgame:

    @staticmethod
    def check(game):

        flags = game.story_flags

        required = [
            "guardian",
            "sand_emperor",
            "frost_queen",
            "inferno_lord",
        ]

        if not all(
            flags.get(flag, False)
            for flag in required
        ):
            return False

        return True

    @staticmethod
    def final_battle(game):

        p = game.player

        clear()

        header("THE FINAL REALM")

        print(
            c(
                """
The four ancient guardians have fallen.

The sky tears open.

Beyond the fracture lies the Void.

A throne floats in an endless darkness.

Something sits upon it.

Something that has been waiting for you.
                """,
                MAGENTA
            )
        )

        pause()

        game.boss_fight(4)

        if p.hp > 0:

            Endgame.ending(game)

        return True

    @staticmethod
    def ending(game):

        p = game.player

        clear()

        header("THE END")

        if p.corruption >= 50:

            ending = """
The Void recognizes you.

You do not destroy it.

You become it.

Across countless worlds, your shadow spreads.

Kings whisper your name.

Heroes hunt you.

And somewhere, another hero begins their journey.
"""

        elif p.reputation >= 100:

            ending = """
The people remember your name.

Cities build statues in your honor.

The old kingdoms unite.

For the first time in a thousand years,
the world knows peace.

You become the first Guardian of the Endless Realms.
"""

        elif p.level >= 30:

            ending = """
You defeat the Void Emperor through sheer strength.

The ancient magic disappears.

The world survives.

You walk away.

Nobody knows where you went.

But every generation tells stories of the hero
who defeated the impossible.
"""

        else:

            ending = """
The Void Emperor falls.

The world survives.

The future remains uncertain.

But you proved one thing:

Even an ordinary hero can change the fate of the world.
"""

        print(
            c(
                ending,
                CYAN
            )
        )

        print()
        print(
            c(
                "CONGRATULATIONS!",
                YELLOW + BOLD
            )
        )

        print(
            f"\nFinal Level: {p.level}"
        )

        print(
            f"Enemies Defeated: {p.kills}"
        )

        print(
            f"Bosses Defeated: {p.bosses}"
        )

        print(
            f"Gold: {p.gold}"
        )

        print(
            f"Deaths: {p.deaths}"
        )

        pause()


