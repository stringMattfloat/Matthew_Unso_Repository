    # =========================================================================
    # SAVE
    # =========================================================================

    def save(self):

        if not self.player:
            return

        data = {
            "player": asdict(self.player),
            "world": {
                "size": self.world.size,
                "tiles": self.world.tiles,
                "towns": {
                    f"{x},{y}": name
                    for (x, y), name
                    in self.world.towns.items()
                },
                "discovered": [
                    list(pos)
                    for pos in self.world.discovered
                ],
            },
            "story_flags": self.story_flags,
            "weather": self.weather,
            "new_game_plus": self.new_game_plus,
        }

        # Convert nested dataclasses manually where necessary.
        data["player"]["weapon"] = (
            asdict(self.player.weapon)
            if self.player.weapon
            else None
        )

        data["player"]["armor"] = (
            asdict(self.player.armor)
            if self.player.armor
            else None
        )

        with open(
            SAVE_FILE,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                data,
                f,
                indent=2
            )

        print(
            c(
                f"Game saved to {SAVE_FILE}.",
                GREEN
            )
        )

        pause()

    # =========================================================================
    # LOAD
    # =========================================================================

    def load(self):

        if not os.path.exists(SAVE_FILE):

            print(
                c(
                    "No save file found.",
                    RED
                )
            )

            pause()
            return False

        try:

            with open(
                SAVE_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                data = json.load(f)

            raw = data["player"]

            weapon_data = raw.pop(
                "weapon",
                None
            )

            armor_data = raw.pop(
                "armor",
                None
            )

            inventory = [
                Item(**item)
                for item in raw.pop(
                    "inventory",
                    []
                )
            ]

            quests = [
                Quest(**quest)
                for quest in raw.pop(
                    "quests",
                    []
                )
            ]

            companions = [
                Companion(**companion)
                for companion in raw.pop(
                    "companions",
                    []
                )
            ]

            self.player = Player(
                **raw,
                weapon=(
                    Weapon(**weapon_data)
                    if weapon_data
                    else None
                ),
                armor=(
                    Armor(**armor_data)
                    if armor_data
                    else None
                ),
                inventory=inventory,
                quests=quests,
                companions=companions,
            )

            world_data = data["world"]

            self.world = World(
                world_data["size"]
            )

            self.world.tiles = (
                world_data["tiles"]
            )

            self.world.towns = {
                tuple(
                    map(
                        int,
                        key.split(",")
                    )
                ): name
                for key, name
                in world_data["towns"].items()
            }

            self.world.discovered = {
                tuple(pos)
                for pos in world_data[
                    "discovered"
                ]
            }

            self.story_flags = data.get(
                "story_flags",
                self.story_flags
            )

            self.weather = data.get(
                "weather",
                "Clear"
            )

            self.new_game_plus = data.get(
                "new_game_plus",
                False
            )

            print(
                c(
                    "Game loaded successfully!",
                    GREEN
                )
            )

            pause()

            return True

        except Exception as exc:

            print(
                c(
                    f"Load failed: {exc}",
                    RED
                )
            )

            pause()

            return False

    # =========================================================================
    # QUIT
    # =========================================================================

    def quit_to_menu(self):

        if choose(
            "Return to main menu?",
            ["Yes", "No"]
        ) == 0:

            self.player = None


