    def rest(self):

        cost = 10

        print(
            f"Resting costs {cost} gold."
        )

        if self.player.gold < cost:

            print(
                "You cannot afford an inn."
            )

            pause()
            return

        if choose(
            "Rest?",
            ["Yes", "No"]
        ) == 0:

            self.player.gold -= cost

            self.player.hp = self.player.max_hp
            self.player.mana = self.player.max_mana

            self.advance_time(8)

            print(
                c(
                    "You wake refreshed.",
