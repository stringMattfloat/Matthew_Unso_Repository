    def update_quests(self, target):

        for quest in self.player.quests:

            if (
                not quest.completed
                and quest.target == target
            ):

                quest.progress += 1

                if quest.progress >= quest.required:
                    quest.completed = True

                    print(
                        c(
                            f"\nQUEST COMPLETE: "
                            f"{quest.title}",
                            YELLOW
                        )
                    )

    def quest_screen(self):

        clear()
        header("QUESTS")

        for quest in self.player.quests:

            status = (
                c("COMPLETE", GREEN)
                if quest.completed
                else f"{quest.progress}/{quest.required}"
            )

            print(
                f"{quest.title:<25} "
                f"{status}"
            )

            print(
                f"  {quest.description}"
            )

            if quest.completed and not quest.claimed:

                print(
                    c(
                        "  Reward available!",
                        YELLOW
                    )
                )

        print()

        if any(
            q.completed and not q.claimed
            for q in self.player.quests
        ):

            if choose(
                "Claim rewards?",
                ["Yes", "No"]
            ) == 0:

                for quest in self.player.quests:

                    if quest.completed and not quest.claimed:

                        quest.claimed = True

                        self.player.gold += (
                            quest.reward_gold
                        )

                        self.player.xp += (
                            quest.reward_xp
                        )

                        print(
                            f"{quest.title}: "
                            f"+{quest.reward_gold}g "
                            f"+{quest.reward_xp} XP"
                        )

                        if quest.reward_item:

                            self.player.inventory.append(
                                Item(
                                    quest.reward_item,
                                    "material",
                                    30,
                                    description="Quest reward."
