    def rarity_color(self, rarity):

        return {
            "Common": WHITE,
            "Uncommon": GREEN,
            "Rare": BLUE,
            "Epic": MAGENTA,
            "Legendary": YELLOW,
            "Mythic": RED,
        }.get(
            rarity,
            WHITE
        )

    def inventory_use(self):

        usable = [
            item
            for item in self.player.inventory
            if item.kind == "consumable"
        ]

        if not usable:
            print("No usable items.")
            pause()
            return

        index = choose(
            "Use",
            [
                item.name
                for item in usable
            ] + ["Back"]
        )

        if index == len(usable):
            return

        self.consume_item(
            usable[index]
        )

        pause()

    def inventory_sell(self):

        if not self.player.inventory:
            return

        index = choose(
            "Sell",
            [
                f"{item.name} ({item.value}g)"
                for item in self.player.inventory
            ] + ["Back"]
        )

        if index == len(self.player.inventory):
            return

        item = self.player.inventory[index]

        self.player.gold += item.value

        self.player.inventory.remove(item)

        print(
            f"Sold {item.name} for "
            f"{item.value} gold."
        )

        pause()

