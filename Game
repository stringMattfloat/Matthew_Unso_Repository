class World:

    def __init__(self, size=15):
        self.size = size
        self.tiles = []

        for y in range(size):
            row = []

            for x in range(size):
                biome = weighted_choice([
                    ("Plains", 30),
                    ("Forest", 20),
                    ("Desert", 10),
                    ("Mountains", 10),
                    ("Swamp", 8),
                    ("Tundra", 7),
                    ("Volcanic", 4),
                    ("Crystal", 4),
                    ("Ruins", 5),
                    ("Ocean", 2),
                ])

                row.append(biome)

            self.tiles.append(row)

        # Starting area
        self.tiles[size // 2][size // 2] = "Plains"

        self.towns = {
            (size // 2, size // 2): "Eldoria",
            (2, 2): "Silverbrook",
            (size - 3, 3): "Ashenfall",
            (3, size - 4): "Frostholm",
        }

        self.discovered = set()

    def biome(self, x, y):
        if not (0 <= x < self.size and 0 <= y < self.size):
            return "Ocean"

        return self.tiles[y][x]

    def is_town(self, x, y):
        return (x, y) in self.towns

    def town_name(self, x, y):
        return self.towns.get((x, y), "")

    def reveal(self, x, y):
        self.discovered.add((x, y))

    def map(self, player):
        header("WORLD MAP")

        px = player.location_x
        py = player.location_y

        for y in range(self.size):
            row = ""

            for x in range(self.size):
                if (x, y) == (px, py):
                    row += c("@ ", YELLOW)
                    continue

                if self.is_town(x, y):
                    row += c("T ", GREEN)
                    continue

                if (x, y) not in self.discovered:
                    row += c("? ", DIM)
                    continue

                symbol = BIOME_SYMBOLS.get(
                    self.biome(x, y),
                    "."
                )

                row += c(symbol + " ", WHITE)

            print(row)

        print()
        print(
            "@ = You | T = Town | ? = Undiscovered"
        )


