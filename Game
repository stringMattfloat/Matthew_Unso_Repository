    def shop(self):

        stock = [
            Item(
                "Health Potion",
                "consumable",
                30,
                effect="heal:50",
                description="Restores 50 HP."
            ),

            Item(
                "Greater Health Potion",
                "consumable",
                70,
                effect="heal:120",
                description="Restores 120 HP."
            ),

            Item(
                "Mana Potion",
                "consumable",
                35,
                effect="mana:40",
                description="Restores 40 mana."
            ),

            Item(
                "Elixir",
                "consumable",
                150,
                effect="full",
                description="Full recovery."
            ),
        ]

        while True:

            clear()
            header("GENERAL STORE")

            index = choose(
                "Buy",
                [
                    f"{item.name} — {item.value}g"
                    for item in stock
                ] + ["Leave"]
            )

            if index == len(stock):
                return

            item = stock[index]

            if self.player.gold < item.value:

                print("Not enough gold.")

            else:

                self.player.gold -= item.value

                self.player.inventory.append(
                    Item(
                        name=item.name,
                        kind=item.kind,
                        value=item.value,
                        effect=item.effect,
                        description=item.description,
                    )
                )

                print(
                    c(
                        "Purchased!",
                        GREEN
                    )
                )

            pause()

    # =========================================================================
    # BLACKSMITH
    # =========================================================================

    def blacksmith(self):

        while True:

            clear()
            header("BLACKSMITH")

            weapon = random.choice(
                WEAPONS[1:]
            )

            armor = random.choice(
                ARMORS[1:]
            )

            options = [
                f"{weapon.name} "
                f"({weapon.damage} damage) — "
                f"{weapon.damage * 15}g",

                f"{armor.name} "
                f"({armor.defense} defense) — "
                f"{armor.defense * 15}g",

                "Leave",
            ]

            choice = choose(
                "Blacksmith",
                options
            )

            if choice == 2:
                return

            if choice == 0:

                price = weapon.damage * 15

                if self.player.gold >= price:

                    self.player.gold -= price

                    self.player.weapon = weapon

                    print(
                        c(
                            f"Equipped {weapon.name}!",
                            GREEN
                        )
                    )

                else:

                    print(
                        "Not enough gold."
                    )

            else:

                price = armor.defense * 15

                if self.player.gold >= price:

                    self.player.gold -= price

                    self.player.armor = armor

                    print(
                        c(
                            f"Equipped {armor.name}!",
                            GREEN
                        )
                    )

                else:

                    print(
                        "Not enough gold."
                    )

            pause()

    # =========================================================================
    # CRAFTING
    # =========================================================================

    def crafting(self):

        while True:

            clear()
            header("CRAFTING")

            choice = choose(
                "Craft",
                [
                    "Health Potion",
                    "Iron Sword",
                    "Steel Armor",
                    "Return",
                ]
            )

            if choice == 3:
                return

            if choice == 0:

                if self.has_material(
                    "Mystic Herb",
                    1
                ):

                    self.remove_material(
                        "Mystic Herb",
                        1
                    )

                    self.player.inventory.append(
                        Item(
                            "Health Potion",
                            "consumable",
                            30,
                            effect="heal:50",
                            description="Restores 50 HP."
                        )
                    )

                    print("Crafted!")

                else:

                    print(
                        "Requires 1 Mystic Herb."
                    )

            elif choice == 1:

                if self.has_material(
                    "Iron Ore",
                    3
                ):

                    self.remove_material(
                        "Iron Ore",
                        3
                    )

                    self.player.weapon = Weapon(
                        "Crafted Iron Sword",
                        20,
                        "Uncommon"
                    )

                    print(
                        c(
                            "You forge an Iron Sword!",
                            GREEN
                        )
                    )

                else:

                    print(
                        "Requires 3 Iron Ore."
                    )

            elif choice == 2:

                if self.has_material(
                    "Iron Ore",
                    5
                ):

                    self.remove_material(
                        "Iron Ore",
                        5
                    )

                    self.player.armor = Armor(
                        "Crafted Steel Armor",
                        18,
                        "Uncommon"
                    )

                    print(
                        c(
                            "You forge Steel Armor!",
                            GREEN
                        )
                    )

                else:

                    print(
                        "Requires 5 Iron Ore."
                    )

            pause()

    def has_material(self, name, amount):

        return sum(
            1
            for item in self.player.inventory
            if item.name == name
        ) >= amount

    def remove_material(self, name, amount):

        removed = 0

        for item in self.player.inventory[:]:

            if item.name == name:

                self.player.inventory.remove(item)

                removed += 1

                if removed >= amount:
                    break

    # =========================================================================
    # REST
