    except KeyboardInterrupt:

        print()
        print(
            c(
                "The adventure ends for now.",
                YELLOW
            )
        )

    except Exception as exc:

        print()
        print(
            c(
                "A fatal game error occurred:",
                RED
            )
        )

        print(exc)

        print()
        print(
            "If this happened during a save/load operation, "
            "check the save file."
        )
