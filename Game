    def check_achievements(self):

        p = self.player

        checks = [
            (
                "First Blood",
                p.kills >= 1
            ),

            (
                "Monster Hunter",
                p.kills >= 25
            ),

            (
                "Treasure Hunter",
                p.treasures >= 10
            ),

            (
                "Master Miner",
                p.ores_mined >= 25
            ),

            (
                "Fisher",
                p.fish_caught >= 10
            ),

            (
                "Boss Slayer",
                p.bosses >= 1
            ),

            (
                "Legend",
                p.level >= 25
            ),

            (
                "Immortal",
                p.deaths == 0 and p.level >= 10
            ),

            (
                "Rich",
                p.gold >= 10000
            ),
        ]

        for name, condition in checks:

            if (
                condition
                and name not in p.achievements
            ):

                p.achievements.append(name)

                print()
