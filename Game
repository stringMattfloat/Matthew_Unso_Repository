    def victory(self, enemy):

        p = self.player

        xp = enemy.xp
        gold = enemy.gold

        p.kills += 1
        p.gold += gold
        p.xp += xp

        print()
        print(
            c(
                f"You defeated {enemy.name}!",
                GREEN
            )
        )

        print(
            f"+{xp} XP"
        )

        print(
            f"+{gold} gold"
        )

        self.update_quests(
            enemy.name
        )

        if chance(0.30):

            loot = self.random_loot()

            p.inventory.append(loot)

            print()
            print(
                c(
                    f"LOOT: {loot.name}",
                    YELLOW
                )
            )

        if enemy.boss:
            p.bosses += 1

        self.check_level_up()
        self.check_achievements()

        pause()

    # =========================================================================
    # LEVELING
    # =========================================================================

    def check_level_up(self):

        p = self.player

        while p.xp >= p.xp_next:

            p.xp -= p.xp_next
            p.level += 1
            p.xp_next = int(
                p.xp_next * 1.45
            )

            hp_gain = random.randint(8, 15)
            mana_gain = random.randint(3, 8)
            attack_gain = random.randint(2, 5)
            defense_gain = random.randint(1, 3)

            p.max_hp += hp_gain
            p.hp = p.max_hp

            p.max_mana += mana_gain
            p.mana = p.max_mana

            p.attack += attack_gain
            p.defense += defense_gain

            print()
            print(
                c(
                    "LEVEL UP!",
                    YELLOW
                )
            )

            print(
                f"You are now level {p.level}!"
            )

            print(
                f"+{hp_gain} max HP"
            )

            print(
                f"+{mana_gain} max mana"
            )

            print(
                f"+{attack_gain} attack"
            )

            print(
                f"+{defense_gain} defense"
            )

            self.unlock_level_skill()

    def unlock_level_skill(self):

        p = self.player

        skill_pool = {
            "Warrior": [
                "Whirlwind",
                "Earthshaker",
                "Berserker Rage",
            ],

            "Mage": [
                "Meteor",
                "Chain Lightning",
                "Void Beam",
            ],

            "Ranger": [
                "Rain of Arrows",
                "Assassinate",
                "Explosive Arrow",
            ],

            "Paladin": [
                "Judgment",
                "Holy Nova",
                "Guardian Angel",
            ],
        }

        available = [
            skill
            for skill in skill_pool[p.class_name]
            if skill not in p.skills
        ]

        if available:

            skill = available[
                min(
                    len(available) - 1,
                    p.level // 5
                )
            ]

            p.skills.append(skill)

            print(
                c(
                    f"New ability learned: {skill}!",
                    MAGENTA
                )
            )

