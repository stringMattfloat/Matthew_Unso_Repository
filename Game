        armor = ARMORS[0]

        self.player = Player(
            name=name,
            class_name=class_name,

            max_hp=stats["hp"],
            hp=stats["hp"],

            max_mana=stats["mana"],
            mana=stats["mana"],

            attack=stats["attack"],
            defense=stats["defense"],
            speed=stats["speed"],

            weapon=weapon,
            armor=armor,

            skills=list(stats["skills"]),
            spells=list(stats["spells"]),
        )

        self.player.inventory.extend([
            Item(
                "Health Potion",
                "consumable",
                30,
                effect="heal:50",
                description="Restores 50 HP."
            ),
            Item(
                "Health Potion",
                "consumable",
                30,
                effect="heal:50",
                description="Restores 50 HP."
            ),
            Item(
                "Mana Potion",
                "consumable",
