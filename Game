    # =========================================================================
    # WORLD MAP
    # =========================================================================

    def show_map(self):

        self.world.map(self.player)
        pause()

    # =========================================================================
    # MOVEMENT / EXPLORATION
    # =========================================================================

    def explore(self):

        header("EXPLORE")

        direction = choose(
            "Travel",
            [
                "North",
                "South",
                "East",
                "West",
                "Stay here",
            ]
        )

        if direction == 4:
            self.random_event()
            return

        dx = [0, 0, 1, -1][direction]
        dy = [-1, 1, 0, 0][direction]

        nx = self.player.location_x + dx
        ny = self.player.location_y + dy

        if not (
            0 <= nx < self.world.size
            and 0 <= ny < self.world.size
        ):
            print(
                c(
                    "You cannot travel that way.",
                    RED
                )
            )
            pause()
            return

        biome = self.world.biome(nx, ny)

        if biome == "Ocean":

            print(
                c(
                    "The ocean blocks your path.",
                    BLUE
                )
            )

            pause()
            return

        self.player.location_x = nx
        self.player.location_y = ny

        self.world.reveal(nx, ny)

        self.advance_time(random.randint(1, 3))

        print(
            f"You travel into the "
            f"{c(biome, CYAN)}."
        )

        if self.world.is_town(nx, ny):
            print(
                c(
                    f"You discover {self.world.town_name(nx, ny)}!",
                    GREEN
                )
            )
            pause()
            return

        self.random_event()

    # =========================================================================
    # TIME
    # =========================================================================

    def advance_time(self, hours):

        self.player.hour += hours

        while self.player.hour >= 24:
            self.player.hour -= 24
            self.player.day += 1

            self.weather = random.choice(
                WEATHER
            )

    # =========================================================================
    # RANDOM EVENTS
    # =========================================================================

    def random_event(self):

        biome = self.world.biome(
            self.player.location_x,
            self.player.location_y
        )

        event = random.random()

        if event < 0.48:
            self.enemy_encounter(biome)

        elif event < 0.60:
            self.find_treasure()

        elif event < 0.70:
            self.gather_resources()

        elif event < 0.78:
            self.find_npc()

        elif event < 0.84:
            self.random_shrine()

        elif event < 0.90:
            self.random_trap()

        else:
            self.mysterious_event()

    # =========================================================================
    # ENCOUNTERS
    # =========================================================================

    def create_enemy(self, biome):

        templates = ENEMIES.get(
            biome,
            ENEMIES["Plains"]
        )

        name, level, hp, attack, defense, speed = (
            random.choice(templates)
        )

        # Scale enemy slightly with player level.
        scale = max(
            0,
            self.player.level - level
        )

        level += random.randint(0, 2) + scale // 2

        hp += level * 8
        attack += level * 2
        defense += level

        return Enemy(
            name=name,
            level=level,
            max_hp=hp,
            hp=hp,
            attack=attack,
            defense=defense,
            speed=speed,
            xp=level * 35,
            gold=level * random.randint(5, 15),
            element={
                "Volcanic": "Fire",
                "Tundra": "Ice",
                "Crystal": "Arcane",
                "Swamp": "Poison",
            }.get(biome, "Physical"),
            skills=[],
            loot=[],
        )

    def enemy_encounter(self, biome):

        enemy = self.create_enemy(biome)

        header("ENCOUNTER")

        print(
            c(
                f"A level {enemy.level} "
                f"{enemy.name} appears!",
                RED
            )
        )

        pause()

        self.combat(enemy)

    # =========================================================================
    # COMBAT
    # =========================================================================

    def combat(self, enemy):

        p = self.player

        p.battles += 1

        defending = False

        while enemy.hp > 0 and p.hp > 0:

            clear()

            header(
                f"BATTLE — {enemy.name}"
            )

            print(
                f"{p.name:<25}"
                f"{enemy.name}"
            )

            print(
                bar(
                    p.hp,
                    p.max_hp,
                    30,
                    GREEN
                )
            )

            print(
                bar(
                    enemy.hp,
                    enemy.max_hp,
                    30,
                    RED
                )
            )

            print()
            print(
                f"Mana: {p.mana}/{p.max_mana}"
            )

            choice = choose(
                "Combat action",
                [
                    "Attack",
                    "Skills",
                    "Magic",
                    "Use Item",
                    "Defend",
                    "Attempt Escape",
                ]
            )

            player_turn = True

            if choice == 0:

                damage = self.player_attack()

                enemy.hp -= damage

                print(
                    c(
                        f"You deal {damage} damage!",
                        GREEN
                    )
                )

            elif choice == 1:

                damage = self.use_skill(enemy)

                if damage is None:
                    continue

                enemy.hp -= damage

            elif choice == 2:

                result = self.use_spell(enemy)

                if result is None:
                    continue

                enemy.hp -= result

            elif choice == 3:

                if not self.use_item_combat():
                    continue

            elif choice == 4:

                defending = True

                print(
                    c(
                        "You brace for impact.",
                        CYAN
                    )
                )

            elif choice == 5:

                if chance(0.5 + p.speed * 0.01):
                    print(
                        c(
                            "You escaped!",
                            YELLOW
                        )
                    )

                    pause()
                    return

                print(
                    c(
                        "You failed to escape!",
                        RED
                    )
                )

            # Enemy turn
            if enemy.hp > 0:

                damage = self.enemy_attack(
                    enemy,
                    defending
                )

                p.hp -= damage

                print(
                    c(
                        f"{enemy.name} deals "
                        f"{damage} damage!",
                        RED
                    )
                )

            defending = False

            if enemy.hp <= 0:
                self.victory(enemy)
                return

            if p.hp <= 0:
                self.death()
                return

            pause()

    # =========================================================================
    # ATTACKS
    # =========================================================================

    def player_attack(self):

        p = self.player

        weapon_damage = (
            p.weapon.damage
            if p.weapon
            else 1
        )

        base = (
            p.attack
            + weapon_damage
        )

        damage = random.randint(
            max(1, base - 4),
            base + 5
        )

        crit_chance = (
            p.weapon.crit
            if p.weapon
            else 0.05
        )

        if chance(crit_chance):
            damage *= 2
            print(c("CRITICAL HIT!", YELLOW))

        return damage

    def enemy_attack(self, enemy, defending=False):

        raw = random.randint(
            max(1, enemy.attack - 5),
            enemy.attack + 5
        )

        defense = self.player.defense

        if self.player.armor:
            defense += self.player.armor.defense

        damage = max(
            1,
            raw - defense // 2
        )

        if defending:
            damage //= 2

        return max(1, damage)

    # =========================================================================
    # SKILLS
    # =========================================================================

    def use_skill(self, enemy):

        p = self.player

        if not p.skills:
            print("You know no skills.")
            pause()
            return None

        index = choose(
            "Skill",
            p.skills + ["Back"]
        )

        if index == len(p.skills):
            return None

        skill = p.skills[index]

        if skill == "Power Strike":

            damage = (
                p.attack
                + p.weapon.damage
            ) * 2

            damage += random.randint(0, 10)

            print(
                c(
                    "POWER STRIKE!",
                    YELLOW
                )
            )

            return damage

        if skill == "Shield Bash":

            damage = p.attack + 10

            if chance(0.35):
                print(
                    c(
                        "Enemy stunned!",
                        CYAN
                    )
                )

            return damage

        if skill == "Arcane Bolt":

            cost = 8

            if p.mana < cost:
                print("Not enough mana.")
                pause()
                return None

            p.mana -= cost

            return 20 + p.level * 4

        if skill == "Precise Shot":

            damage = p.attack + 20

            if chance(0.35):
                damage *= 2
                print(c("Perfect shot!", YELLOW))

            return damage

        if skill == "Poison Arrow":

            damage = p.attack + 12

            if chance(0.5):
                damage += 10

            return damage

        if skill == "Holy Strike":

            damage = p.attack + 25

            if enemy.element == "Void":
                damage *= 2

            return damage

        if skill == "Divine Shield":

            heal = 20 + p.level * 4

            p.hp = min(
                p.max_hp,
                p.hp + heal
            )

            print(
                c(
                    f"Divine energy restores {heal} HP.",
                    GREEN
                )
            )

            return 0

        return p.attack

    # =========================================================================
    # SPELLS
    # =========================================================================

    def use_spell(self, enemy):

        p = self.player

        if not p.spells:
            print("You know no spells.")
            pause()
            return None

        index = choose(
            "Spell",
            p.spells + ["Back"]
        )

        if index == len(p.spells):
            return None

        spell = p.spells[index]

        costs = {
            "Fireball": 15,
            "Ice Lance": 12,
            "Lightning": 20,
            "Heal": 18,
        }

        cost = costs.get(
            spell,
            10
        )

        if p.mana < cost:
            print("Not enough mana.")
            pause()
            return None

        p.mana -= cost

        if spell == "Fireball":

            damage = 35 + p.level * 6

            if enemy.element == "Ice":
                damage *= 2

            print(c("FIREBALL!", RED))

            return damage

        if spell == "Ice Lance":

            damage = 30 + p.level * 5

            print(c("ICE LANCE!", BLUE))

            return damage

        if spell == "Lightning":

            damage = 45 + p.level * 7

            print(c("LIGHTNING!", YELLOW))

            return damage

        if spell == "Heal":

            heal = 45 + p.level * 5

            p.hp = min(
                p.max_hp,
                p.hp + heal
            )

            print(
                c(
                    f"You heal {heal} HP.",
                    GREEN
                )
            )

            return 0

        return 0

    # =========================================================================
    # ITEMS IN COMBAT
    # =========================================================================

    def use_item_combat(self):

        usable = [
            item
            for item in self.player.inventory
            if item.kind == "consumable"
        ]

        if not usable:
            print("You have no usable items.")
            pause()
            return False

        names = [
            f"{item.name} — {item.description}"
            for item in usable
        ]

        index = choose(
            "Item",
            names + ["Back"]
        )

        if index == len(usable):
            return False

        item = usable[index]

        self.consume_item(item)

        return True

    def consume_item(self, item):

        if item.effect.startswith("heal:"):

            amount = int(
                item.effect.split(":")[1]
            )

            old = self.player.hp

            self.player.hp = min(
                self.player.max_hp,
                self.player.hp + amount
            )

            print(
                c(
                    f"Recovered "
                    f"{self.player.hp - old} HP.",
                    GREEN
                )
            )

        elif item.effect.startswith("mana:"):

            amount = int(
                item.effect.split(":")[1]
            )

            old = self.player.mana

            self.player.mana = min(
                self.player.max_mana,
                self.player.mana + amount
            )

            print(
                c(
                    f"Recovered "
                    f"{self.player.mana - old} mana.",
                    BLUE
                )
            )

        elif item.effect == "full":

            self.player.hp = self.player.max_hp
            self.player.mana = self.player.max_mana

            print(
                c(
                    "Completely restored!",
                    GREEN
                )
            )

        self.player.inventory.remove(item)

