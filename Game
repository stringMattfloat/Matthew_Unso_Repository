                self.explore,
                self.show_map,
                self.character_screen,
                self.inventory_screen,
                self.quest_screen,
                self.skills_screen,
                self.companion_screen,
                self.town_menu,
                self.crafting,
                self.rest,
                self.save,
                self.statistics,
                self.quit_to_menu,
            ]

            actions[choice]()

