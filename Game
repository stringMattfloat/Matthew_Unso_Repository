                    "World Map",
                    "Character",
                    "Inventory",
                    "Quests",
                    "Skills & Magic",
                    "Companions",
                    "Town",
                    "Crafting",
                    "Rest",
                    "Save",
                    "Statistics",
                    "Quit to Menu",
