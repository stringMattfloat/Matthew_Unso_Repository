class Formatter:

    @staticmethod
    def table(headers, rows):
        widths = [
            len(str(header))
            for header in headers
        ]

        for row in rows:
            for i, value in enumerate(row):
                widths[i] = max(
                    widths[i],
                    len(str(value))
                )

        separator = "+".join(
            "-" * (width + 2)
            for width in widths
        )

        output = []

        output.append(
            "+-" + "-+-".join(
                "-" * width
                for width in widths
            ) + "-+"
        )

        output.append(
            "| "
            + " | ".join(
                str(value).ljust(widths[i])
                for i, value in enumerate(headers)
            )
            + " |"
        )

        output.append(
            "+-"
            + "-+-".join(
                "-" * width
                for width in widths
            )
            + "-+"
        )

        for row in rows:
            output.append(
                "| "
                + " | ".join(
                    str(value).ljust(widths[i])
                    for i, value in enumerate(row)
                )
                + " |"
            )

        output.append(
            "+-"
            + "-+-".join(
                "-" * width
                for width in widths
            )
            + "-+"
        )

        return "\n".join(output)


