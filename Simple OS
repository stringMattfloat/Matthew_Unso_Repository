def main():
    if "--test" in sys.argv:
        run_tests()
        return

    if "--world" in sys.argv:
        world = WorldGenerator.generate_world(20)

        for location in world:
            print(
                f"\n{color(location['name'], 'cyan')}"
            )

            for creature in location["creatures"]:
                print(
                    f"  {creature['name']:<12} "
                    f"LVL {creature['level']:<3} "
                    f"HP {creature['hp']:<3} "
                    f"ATK {creature['attack']:<3} "
                    f"DEF {creature['defense']:<3}"
                )

        return

    if "--cipher" in sys.argv:
        text = safe_input("Text: ")
        key = safe_input("Key: ")

        encoded = SimpleCipher.encode(
            text,
            key
        )

        print("Encoded:", encoded)
        print(
            "Decoded:",
            SimpleCipher.decode(
                encoded,
                key
            )
        )

        return

    boot_sequence()

    shell = MegaShell()

    try:
        shell.run()

    except KeyboardInterrupt:
        print("\nEmergency shutdown.")

    except Exception:
        print(
            color(
                "\nFATAL ERROR\n",
                "red"
            )
        )

        traceback.print_exc()


