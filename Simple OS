class MiniScript:

    """
    Tiny scripting language.

    Commands:
        print hello
        set x = 10
        add x 5
        sleep 1
        repeat 3 hello
    """

    def __init__(self, shell):
        self.shell = shell
        self.variables = {}

    def substitute(self, text):
        def replace(match):
            name = match.group(1)
            return str(self.variables.get(name, ""))

        return re.sub(r"\$\{(\w+)\}", replace, text)

    def run_line(self, line):
        line = self.substitute(line.strip())

        if not line:
            return

        if line.startswith("#"):
            return

        parts = shlex.split(line)

        if not parts:
            return

        command = parts[0].lower()

        if command == "print":
            print(" ".join(parts[1:]))

        elif command == "set":
            if len(parts) >= 4 and parts[2] == "=":
                self.variables[parts[1]] = " ".join(parts[3:])

        elif command == "add":
            name = parts[1]
            amount = float(parts[2])

            current = float(
                self.variables.get(name, 0)
            )

            self.variables[name] = current + amount

        elif command == "sleep":
            time.sleep(float(parts[1]))

        elif command == "repeat":
            count = int(parts[1])
            message = " ".join(parts[2:])

            for _ in range(count):
                print(self.substitute(message))

        else:
            self.shell.execute(line)

    def run(self, source):
        for line in source.splitlines():
            try:
                self.run_line(line)
            except Exception as exc:
                print(
                    color(
                        f"Script error: {exc}",
                        "red"
                    )
                )


