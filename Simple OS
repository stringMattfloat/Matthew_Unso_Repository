class TodoManager:

    def __init__(self):
        self.todos: list[Todo] = []

    def add(self, title, priority="normal"):
        item = Todo(
            id=make_id(),
            title=title,
            priority=priority,
        )

        self.todos.append(item)
        return item

    def complete(self, todo_id):
        for todo in self.todos:
            if todo.id == todo_id:
                todo.completed = True
                return todo

        return None

    def remove(self, todo_id):
        for i, todo in enumerate(self.todos):
            if todo.id == todo_id:
                return self.todos.pop(i)

        return None

    def pending(self):
        return [x for x in self.todos if not x.completed]

    def done(self):
        return [x for x in self.todos if x.completed]


