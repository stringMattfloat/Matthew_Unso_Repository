def boot_sequence():
    clear_screen()

    stages = [
        "Initializing MEGA kernel...",
        "Loading virtual filesystem...",
        "Mounting /home...",
        "Starting task manager...",
        "Initializing user database...",
        "Loading command registry...",
        "Starting event bus...",
        "Loading applications...",
        "Starting games subsystem...",
        "Calibrating absurdity engine...",
        "Checking reality...",
        "Reality check: FAILED.",
        "Continuing anyway...",
    ]

    for stage in stages:
        print(
            color(
                "[BOOT] ",
                "green"
            )
            + stage
        )

        time.sleep(0.04)

    print()
    print(
        color(
            "BOOT COMPLETE.",
            "green"
        )
    )

    time.sleep(0.3)


