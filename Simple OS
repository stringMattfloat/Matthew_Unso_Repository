def color(text: str, name: str) -> str:
    """Return ANSI-colored text."""
    return COLORS.get(name, "") + str(text) + COLORS["reset"]


def clear_screen() -> None:
    os.system("cls" if os.name == "nt" else "clear")


def pause(message: str = "Press Enter to continue...") -> None:
    try:
        input(message)
    except EOFError:
        pass


def safe_input(prompt: str = "") -> str:
    try:
        return input(prompt)
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def now() -> dt.datetime:
    return dt.datetime.now()


def timestamp() -> str:
    return now().strftime("%Y-%m-%d %H:%M:%S")


def make_id() -> str:
    return uuid.uuid4().hex[:12]


def human_size(size: int) -> str:
    units = ["B", "KB", "MB", "GB", "TB"]
    value = float(size)

    for unit in units:
        if value < 1024:
            return f"{value:.1f} {unit}"
        value /= 1024

    return f"{value:.1f} PB"


def wrap(text: str, width: int = 78) -> str:
    return "\n".join(textwrap.wrap(str(text), width=width))


def boxed(title: str, content: str, width: int = 78) -> str:
    title = f" {title} "
    top = "┌" + "─" * (width - 2) + "┐"
    bottom = "└" + "─" * (width - 2) + "┘"

    lines = [top]

    if title:
        lines.append(
            "│" + title.center(width - 2) + "│"
        )
        lines.append("├" + "─" * (width - 2) + "┤")

    for line in content.splitlines():
        for wrapped in textwrap.wrap(line, width - 4) or [""]:
            lines.append("│ " + wrapped.ljust(width - 3) + "│")

    lines.append(bottom)
    return "\n".join(lines)


def random_choice(items):
    return random.choice(list(items))


