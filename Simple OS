# EXTRA MODULE: MINI HTTP-LIKE ROUTER
# =============================================================================

class Router:

    def __init__(self):
        self.routes = {}

    def route(self, path, method="GET"):
        method = method.upper()

        def decorator(function):
            self.routes[
                (method, path)
            ] = function

            return function

        return decorator

    def dispatch(
        self,
        path,
        method="GET",
        **kwargs
    ):
        function = self.routes.get(
            (method.upper(), path)
        )

        if function is None:
            return {
                "status": 404,
                "body": "Not Found",
            }

        try:
            body = function(**kwargs)

            return {
                "status": 200,
                "body": body,
            }

        except Exception as exc:
            return {
                "status": 500,
                "body": str(exc),
            }


