class Persistence:

    @staticmethod
    def save(shell, filename=DATA_FILE):
        data = {
            "users": {
                username: asdict(user)
                for username, user
                in shell.users.users.items()
            },

            "todos": [
                asdict(todo)
                for todo in shell.todos.todos
            ],

            "contacts": [
                asdict(contact)
                for contact in shell.contacts.contacts
            ],

            "calendar": [
                asdict(event)
                for event in shell.calendar.events
            ],

            "variables": shell.variables,
        }

        with open(filename, "w", encoding="utf-8") as file:
            json.dump(
                data,
                file,
                indent=2,
                ensure_ascii=False,
            )

    @staticmethod
    def load(shell, filename=DATA_FILE):
        if not os.path.exists(filename):
            return False

        with open(filename, "r", encoding="utf-8") as file:
            data = json.load(file)

        shell.users.users.clear()

        for username, raw in data.get("users", {}).items():
            shell.users.users[username] = User(**raw)

        shell.todos.todos = [
            Todo(**raw)
            for raw in data.get("todos", [])
        ]

        shell.contacts.contacts = [
            Contact(**raw)
            for raw in data.get("contacts", [])
        ]

        shell.calendar.events = [
            CalendarEvent(**raw)
            for raw in data.get("calendar", [])
        ]

        shell.variables.update(
            data.get("variables", {})
        )

        return True


# =============================================================================
# COMMAND REGISTRY
# =============================================================================

class CommandRegistry:

    def __init__(self):
        self.commands = {}

    def register(
        self,
        name: str,
        description: str,
        function: Callable,
        aliases=None,
    ):
        self.commands[name] = {
            "description": description,
            "function": function,
            "aliases": aliases or [],
        }

    def find(self, name):
        if name in self.commands:
            return self.commands[name]

        for command in self.commands.values():
            if name in command["aliases"]:
                return command

        return None

    def help(self):
        lines = []

        for name in sorted(self.commands):
            command = self.commands[name]

            lines.append(
                f"{name:<15} {command['description']}"
            )

        return "\n".join(lines)


