class Games:

    @staticmethod
    def guessing():
        clear_screen()

        print(boxed(
            "NUMBER GUESSING",
            "I'm thinking of a number from 1 to 100."
        ))

        number = random.randint(1, 100)
        attempts = 0

        while True:
            raw = safe_input("Guess: ")

            try:
                guess = int(raw)
            except ValueError:
                print("Enter a number.")
                continue

            attempts += 1

            if guess < number:
                print("Higher!")
            elif guess > number:
                print("Lower!")
            else:
                print(
                    color(
                        f"You got it in {attempts} attempts!",
                        "green"
                    )
                )
                break

    @staticmethod
    def hangman():
        words = [
            "python",
            "computer",
            "galaxy",
            "keyboard",
            "algorithm",
            "database",
            "programming",
            "terminal",
            "filesystem",
            "internet",
        ]

        word = random.choice(words)
        guessed = set()
        wrong = set()

        stages = [
            "  +---+\n      |\n      |\n      |\n     ===",
            "  +---+\n  O   |\n      |\n      |\n     ===",
            "  +---+\n  O   |\n  |   |\n      |\n     ===",
            "  +---+\n  O   |\n /|   |\n      |\n     ===",
            "  +---+\n  O   |\n /|\\  |\n      |\n     ===",
            "  +---+\n  O   |\n /|\\  |\n /    |\n     ===",
            "  +---+\n  O   |\n /|\\  |\n / \\  |\n     ===",
        ]

        while len(wrong) < 6:
            clear_screen()

            display = " ".join(
                c if c in guessed else "_"
                for c in word
            )

            print(stages[len(wrong)])
            print()
            print(display)
            print("Wrong:", " ".join(sorted(wrong)))

            if all(c in guessed for c in word):
                print(color("YOU WIN!", "green"))
                return

            letter = safe_input("Letter: ").lower().strip()

            if len(letter) != 1 or not letter.isalpha():
                continue

            if letter in word:
                guessed.add(letter)
            else:
                wrong.add(letter)

        clear_screen()
        print(stages[6])
        print("The word was:", word)
