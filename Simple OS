    # -------------------------------------------------------------------------

    def execute(self, line: str):
        line = line.strip()

        if not line:
            return

        self.history.append(line)

        # Aliases
        parts = shlex.split(line)

        if not parts:
            return

        command_name = parts[0]

        if command_name in self.aliases:
            replacement = self.aliases[command_name]

            remaining = " ".join(
                shlex.quote(x)
                for x in parts[1:]
            )

            line = (
                replacement + " " + remaining
                if remaining
                else replacement
            )

            parts = shlex.split(line)
            command_name = parts[0]

        command = self.registry.find(command_name)

        if command is None:
            print(
                color(
                    f"Unknown command: {command_name}",
                    "red"
                )
            )
            print("Type 'help' for commands.")
            return

        args = parts[1:]

        try:
            command["function"](args)
        except Exception as exc:
            LOGGER.error(
                f"Command {command_name} failed: {exc}"
            )

            print(
                color(
                    f"Error: {exc}",
                    "red"
                )
            )

