class SelfTest:

    def __init__(self):
        self.results = []

    def check(self, name, function):
        try:
            function()

            self.results.append(
                (name, True, "")
            )

        except Exception as exc:
            self.results.append(
                (name, False, str(exc))
            )

    def run(self):
        self.check(
            "Calculator",
            lambda: assert_equal(
                Calculator.evaluate("2 + 3 * 4"),
                14
            )
        )

        self.check(
            "Filesystem",
            self.test_filesystem
        )

        self.check(
            "Cipher",
            self.test_cipher
        )

        self.check(
            "Router",
            self.test_router
        )

        self.check(
            "World Generator",
            self.test_world
        )

        return self.results

    def test_filesystem(self):
        fs = VirtualFileSystem()

        fs.mkdir("/test")
        fs.write(
            "/test/hello.txt",
            "hello"
        )

        assert_equal(
            fs.read("/test/hello.txt"),
            "hello"
        )

    def test_cipher(self):
        text = "MEGA OS IS HUGE"
        key = "secret"

        encrypted = SimpleCipher.encode(
            text,
            key
        )

        decrypted = SimpleCipher.decode(
            encrypted,
            key
        )

        assert_equal(
            decrypted,
            text
        )

    def test_router(self):
        result = router.dispatch("/")

        assert_equal(
            result["status"],
            200
        )

    def test_world(self):
        world = WorldGenerator.generate_world(5)

        assert_equal(
            len(world),
            5
        )


