# EXTRA MODULE: ENCRYPTION UTILITIES
# =============================================================================

class SimpleCipher:
    """
    Educational reversible cipher.

    This is NOT cryptographically secure.
    """

    @staticmethod
    def xor(data: str, key: str):
        if not key:
            raise ValueError("Key cannot be empty")

        encoded = []

        for index, char in enumerate(data):
            encoded.append(
                chr(
                    ord(char)
                    ^ ord(key[index % len(key)])
                )
            )

        return "".join(encoded)

    @staticmethod
    def encode(data: str, key: str):
        encrypted = SimpleCipher.xor(
            data,
            key
        )

        return base64.b64encode(
            encrypted.encode()
        ).decode()

    @staticmethod
    def decode(data: str, key: str):
        raw = base64.b64decode(
            data.encode()
        ).decode()

        return SimpleCipher.xor(
            raw,
            key
        )


