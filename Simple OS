class VNode:

    def __init__(
        self,
        name: str,
        node_type: str,
        content: str = "",
        parent: Optional["VNode"] = None,
    ):
        self.name = name
        self.node_type = node_type
        self.content = content
        self.parent = parent
        self.children = {}
        self.created = timestamp()
        self.modified = timestamp()
        self.permissions = "rwxr-xr-x"

    @property
    def path(self):
        if self.parent is None:
            return "/"

        parts = []
        current = self

        while current.parent is not None:
            parts.append(current.name)
            current = current.parent

        return "/" + "/".join(reversed(parts))

    @property
    def size(self):
        if self.node_type == "file":
            return len(self.content.encode())

        return sum(child.size for child in self.children.values())

    def add_child(self, node):
        node.parent = self
        self.children[node.name] = node
        self.modified = timestamp()

    def remove_child(self, name):
        if name not in self.children:
            raise FileNotFoundError(name)

        del self.children[name]
        self.modified = timestamp()


class VirtualFileSystem:

    def __init__(self):
        self.root = VNode("", "directory")
        self._build_default_tree()

    def _build_default_tree(self):
        for directory in [
            "/bin",
            "/etc",
            "/home",
            "/tmp",
            "/var",
            "/var/log",
            "/var/tmp",
            "/usr",
            "/usr/bin",
            "/usr/share",
            "/games",
        ]:
            self.mkdir(directory)

        self.write(
            "/etc/motd",
            f"Welcome to {SYSTEM_NAME} {VERSION}\n"
        )

        self.write(
            "/etc/hostname",
            "mega-computer\n"
        )

        self.write(
            "/usr/share/readme.txt",
            "This is the MEGA-OS virtual filesystem.\n"
        )

    def normalize(self, path: str, cwd: str = "/") -> str:
        if not path:
            return cwd

        if path.startswith("/"):
            combined = PurePosixPath(path)
        else:
            combined = PurePosixPath(cwd) / path

        normalized = str(combined)

        if not normalized.startswith("/"):
            normalized = "/" + normalized

        parts = []

        for part in normalized.split("/"):
            if not part or part == ".":
                continue

            if part == "..":
                if parts:
                    parts.pop()
            else:
                parts.append(part)

        return "/" + "/".join(parts)

    def resolve(self, path: str, cwd: str = "/") -> VNode:
        path = self.normalize(path, cwd)

        if path == "/":
            return self.root

        current = self.root

        for component in path.strip("/").split("/"):
            if component not in current.children:
                raise FileNotFoundError(path)

            current = current.children[component]

        return current

    def exists(self, path, cwd="/"):
        try:
            self.resolve(path, cwd)
            return True
        except FileNotFoundError:
            return False

    def mkdir(self, path: str, cwd: str = "/", parents=True):
        path = self.normalize(path, cwd)

        if path == "/":
            return

        parts = path.strip("/").split("/")
        current = self.root

        for part in parts:
            if part not in current.children:
                if not parents:
                    raise FileNotFoundError(
                        f"Parent does not exist: {current.path}"
                    )

                current.add_child(VNode(part, "directory"))

            current = current.children[part]

            if current.node_type != "directory":
                raise NotADirectoryError(current.path)

    def touch(self, path, cwd="/"):
        path = self.normalize(path, cwd)

        parent_path = str(PurePosixPath(path).parent)
        name = PurePosixPath(path).name

        parent = self.resolve(parent_path)

        if name not in parent.children:
            parent.add_child(VNode(name, "file"))

        parent.children[name].modified = timestamp()

    def write(self, path, content, cwd="/"):
        path = self.normalize(path, cwd)

        parent_path = str(PurePosixPath(path).parent)
        name = PurePosixPath(path).name

        parent = self.resolve(parent_path)

        if name in parent.children:
            node = parent.children[name]

            if node.node_type != "file":
                raise IsADirectoryError(path)

            node.content = content
            node.modified = timestamp()
        else:
            parent.add_child(
                VNode(name, "file", content=content)
            )

    def append(self, path, content, cwd="/"):
        old = ""

        if self.exists(path, cwd):
            old = self.read(path, cwd)

        self.write(path, old + content, cwd)

    def read(self, path, cwd="/"):
        node = self.resolve(path, cwd)

        if node.node_type != "file":
            raise IsADirectoryError(path)

        return node.content

    def remove(self, path, cwd="/"):
        node = self.resolve(path, cwd)

        if node is self.root:
            raise PermissionError("Cannot remove root")

        node.parent.remove_child(node.name)

    def listdir(self, path="/", cwd="/"):
        node = self.resolve(path, cwd)

        if node.node_type != "directory":
            raise NotADirectoryError(path)

        return sorted(node.children.values(), key=lambda x: x.name)

    def find(self, pattern, start="/"):
        results = []

        def walk(node):
            if re.search(pattern, node.name):
                results.append(node.path)

            for child in node.children.values():
                walk(child)

        walk(self.resolve(start))
        return results

    def tree(self, path="/", prefix=""):
        node = self.resolve(path)
        lines = [node.name or "/"]

        children = sorted(
            node.children.values(),
            key=lambda x: x.name
        )

        def recurse(parent, current_prefix):
            children = sorted(
                parent.children.values(),
                key=lambda x: x.name
            )

            for index, child in enumerate(children):
                last = index == len(children) - 1
                connector = "└── " if last else "├── "

                lines.append(
                    current_prefix + connector + child.name
                )

                if child.node_type == "directory":
                    recurse(
                        child,
                        current_prefix + ("    " if last else "│   ")
                    )

        recurse(node, prefix)
        return "\n".join(lines)

    def disk_usage(self):
        return self.root.size


