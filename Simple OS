    @staticmethod
    def tictactoe():
        board = [" "] * 9

        def display():
            print()
            print(
                f" {board[0]} | {board[1]} | {board[2]}\n"
                "---+---+---\n"
                f" {board[3]} | {board[4]} | {board[5]}\n"
                "---+---+---\n"
                f" {board[6]} | {board[7]} | {board[8]}"
            )
            print()

        def winner(mark):
            wins = [
                (0, 1, 2),
                (3, 4, 5),
                (6, 7, 8),
                (0, 3, 6),
                (1, 4, 7),
                (2, 5, 8),
                (0, 4, 8),
                (2, 4, 6),
            ]

            return any(
                all(board[i] == mark for i in combo)
                for combo in wins
            )

        turn = "X"

        while True:
            clear_screen()
            display()

            if turn == "X":
                raw = safe_input(
                    "Choose a square (1-9): "
                )

                try:
                    move = int(raw) - 1
                except ValueError:
                    continue
            else:
                available = [
                    i for i, value in enumerate(board)
                    if value == " "
                ]

                move = random.choice(available)
                print(f"Computer chooses {move + 1}")
                time.sleep(0.5)

            if not 0 <= move < 9:
                continue

            if board[move] != " ":
                continue

            board[move] = turn

            if winner(turn):
                clear_screen()
                display()

                if turn == "X":
                    print(color("YOU WIN!", "green"))
                else:
                    print(color("COMPUTER WINS!", "red"))

                pause()
                return

            if " " not in board:
                clear_screen()
                display()
                print("DRAW!")
                pause()
                return

            turn = "O" if turn == "X" else "X"

    @staticmethod
    def minesweeper():
        width = 9
        height = 9
        mines = 10

        mine_positions = set()

        while len(mine_positions) < mines:
            mine_positions.add(
                (
                    random.randrange(width),
                    random.randrange(height),
                )
            )

        revealed = set()
        flags = set()

        def neighbors(x, y):
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    if dx == 0 and dy == 0:
                        continue

                    nx = x + dx
                    ny = y + dy

                    if 0 <= nx < width and 0 <= ny < height:
                        yield nx, ny

        def count_mines(x, y):
            return sum(
                (nx, ny) in mine_positions
                for nx, ny in neighbors(x, y)
            )

        def draw():
            clear_screen()

            print("   " + " ".join(
                str(i) for i in range(width)
            ))

            for y in range(height):
                row = []

                for x in range(width):
                    pos = (x, y)

                    if pos in flags:
                        row.append("F")
                    elif pos not in revealed:
                        row.append("#")
                    elif pos in mine_positions:
                        row.append("*")
                    else:
                        number = count_mines(x, y)
                        row.append(
                            "." if number == 0
                            else str(number)
                        )

                print(f"{y:2} " + " ".join(row))

        while True:
            draw()

            command = safe_input(
                "reveal x y / flag x y / quit: "
            ).split()

            if not command:
                continue

            if command[0] == "quit":
                return

            if len(command) != 3:
                continue

            try:
                x = int(command[1])
                y = int(command[2])
            except ValueError:
                continue

            if not (0 <= x < width and 0 <= y < height):
                continue

            pos = (x, y)

            if command[0] == "flag":
                if pos in flags:
                    flags.remove(pos)
                else:
                    flags.add(pos)

            elif command[0] == "reveal":
                if pos in mine_positions:
                    draw()
                    print()
                    print(color(
                        "BOOM! You hit a mine.",
                        "red"
                    ))
                    pause()
                    return

                stack = [pos]

                while stack:
                    current = stack.pop()

                    if current in revealed:
                        continue

                    revealed.add(current)

                    cx, cy = current

                    if count_mines(cx, cy) == 0:
                        for neighbor in neighbors(cx, cy):
                            if neighbor not in revealed:
                                stack.append(neighbor)

                safe_cells = width * height - mines

                if len(revealed) >= safe_cells:
                    draw()
                    print(color(
                        "YOU CLEARED THE BOARD!",
                        "green"
                    ))
                    pause()
                    return

    @staticmethod
    def dungeon():
        player = {
            "hp": 30,
            "max_hp": 30,
            "attack": 7,
            "gold": 0,
            "potions": 2,
        }

        enemies = [
            ("Goblin", 12, 4, 8),
            ("Skeleton", 16, 5, 12),
            ("Orc", 24, 7, 18),
            ("Dark Mage", 20, 9, 25),
            ("Dragon", 50, 12, 100),
        ]

        print(boxed(
            "MEGA DUNGEON",
            "Defeat enemies and collect treasure."
        ))

        for name, hp, attack, reward in enemies:
            enemy_hp = hp

            print()
            print(
                color(
                    f"A {name} appears!",
                    "yellow"
                )
            )

            while enemy_hp > 0 and player["hp"] > 0:
                print()
                print(
                    f"You: {player['hp']}/{player['max_hp']} HP"
                )
                print(
                    f"{name}: {enemy_hp}/{hp} HP"
                )
                print(
                    f"Gold: {player['gold']} | "
                    f"Potions: {player['potions']}"
                )

                action = safe_input(
                    "[A]ttack [P]otion [R]un: "
                ).lower()

                if action == "a":
                    damage = random.randint(
                        player["attack"] - 2,
                        player["attack"] + 3,
                    )

                    enemy_hp -= max(1, damage)

                    print(
                        f"You deal {damage} damage!"
                    )

                elif action == "p":
                    if player["potions"] <= 0:
                        print("No potions!")
                        continue

                    heal = random.randint(8, 15)

                    player["hp"] = min(
                        player["max_hp"],
                        player["hp"] + heal
                    )

                    player["potions"] -= 1

                    print(f"You heal {heal} HP.")

                elif action == "r":
                    if random.random() < 0.5:
                        print("You escaped!")
                        return

                    print("You failed to escape!")

                else:
                    continue

                if enemy_hp > 0:
                    damage = random.randint(
                        max(1, attack - 2),
                        attack + 2
                    )

                    player["hp"] -= damage

                    print(
                        f"{name} deals {damage} damage!"
                    )

            if player["hp"] <= 0:
                print(color(
                    "You have fallen in the dungeon.",
                    "red"
                ))
                return

            player["gold"] += reward

            print(color(
                f"You defeated the {name}! +{reward} gold",
                "green"
            ))

            if random.random() < 0.35:
                player["potions"] += 1
                print("You found a potion!")

        print()
        print(color(
            f"DUNGEON CLEARED! Gold: {player['gold']}",
            "green"
        ))
        pause()


