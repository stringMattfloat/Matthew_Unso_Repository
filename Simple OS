    def cmd_cd(self, args):
        target = args[0] if args else "~"

        if target == "~":
            target = self.current_user.home

        path = self.fs.normalize(
            target,
            self.cwd
        )

        node = self.fs.resolve(path)

        if node.node_type != "directory":
            raise NotADirectoryError(path)

        self.cwd = path

    def cmd_ls(self, args):
        target = args[0] if args else self.cwd

        nodes = self.fs.listdir(
            target,
            self.cwd
        )

        if not nodes:
            return

        for node in nodes:
            if node.node_type == "directory":
                name = color(
                    node.name + "/",
                    "cyan"
                )
            else:
                name = node.name

            print(
                f"{name:<30}"
                f"{node.node_type:<10}"
                f"{human_size(node.size):>10}"
            )

