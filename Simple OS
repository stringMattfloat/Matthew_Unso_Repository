class TaskManager:

    def __init__(self):
        self.tasks = []
        self.next_pid = 100

        self.create("kernel", "system")
        self.create("init", "system")
        self.create("shell", "system")

    def create(self, name, owner):
        task = Task(
            pid=self.next_pid,
            name=name,
            owner=owner,
            cpu=random.random() * 5,
            memory=random.random() * 100,
        )

        self.next_pid += 1
        self.tasks.append(task)
        return task

    def kill(self, pid):
        for task in self.tasks:
            if task.pid == pid:
                task.status = "TERMINATED"
                return task

        return None

    def running(self):
        return [
            task for task in self.tasks
            if task.status == "RUNNING"
        ]


